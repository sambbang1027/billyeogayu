<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="app.domains.list.dao.ListRepository">

    <!-- 공통 매핑 -->
    <resultMap id="assetMap" type="app.domains.asset.model.Asset">
        <id property="assetId" column="ASSET_ID"/>
        <result property="name" column="NAME"/>
        <result property="category" column="CATEGORY"/>
        <result property="company" column="COMPANY"/>
        <result property="status" column="STATUS"/>
        <result property="image" column="IMAGE"/>
        <result property="maintenanceCycle" column="MAINTENANCE_CYCLE"/>
        <result property="usageTime" column="USAGE_TIME"/>
        <result property="lastMaintenanceDate" column="LAST_MAINTENANCE_DATE"/>
        <result property="expectedMaintenanceDate" column="EXPECTED_MAINTENANCE_DATE"/>
        <result property="createdAt" column="CREATED_AT"/>
        <result property="updatedAt" column="UPDATED_AT"/>
        <result property="deletedAt" column="DELETED_AT"/>
        <result property="isDeleted" column="IS_DELETED"/>
    </resultMap>

    <!-- 목록 조회 (검색 + 필터 + 페이징) -->
    <select id="findAssets" parameterType="map" resultMap="assetMap">
        SELECT *
        FROM ASSET
        WHERE IS_DELETED = 'N'
        <if test="q != null and q != ''">
            AND LOWER(NAME) LIKE '%' || LOWER(#{q}) || '%'
        </if>
        <if test="filter != null and filter == 'available'">
            AND STATUS = 'AVAILABLE'
        </if>
        ORDER BY NAME ASC
        OFFSET #{offset} ROWS FETCH NEXT #{pageSize} ROWS ONLY
    </select>

    <!-- 총 개수 -->
    <select id="countAssets" parameterType="map" resultType="int">
        SELECT COUNT(*)
        FROM ASSET
        WHERE IS_DELETED = 'N'
        <if test="q != null and q != ''">
            AND LOWER(NAME) LIKE '%' || LOWER(#{q}) || '%'
        </if>
        <if test="filter != null and filter == 'available'">
            AND STATUS = 'AVAILABLE'
        </if>
    </select>

</mapper>
