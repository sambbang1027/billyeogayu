<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
  <mapper namespace="app.domains.maintenance.dao.MaintenanceRepository">
  		
  		<select id="getPartList" parameterType="int" resultType="hashmap">
  				SELECT part_id, name
  				FROM part
  				WHERE asset_id = #{assetId}
  		</select>
  		
  		
  		<select id="getNextRequestId" resultType="int">
		    SELECT SEQ_REQUEST_ID.NEXTVAL FROM dual
		</select>

