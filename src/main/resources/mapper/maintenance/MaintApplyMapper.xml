			<insert id="applyMaintenance" parameterType="map">
			    INSERT INTO maintenance (
			        asset_id, admin_id, part_id, type, item, resolver_name, request_id, owner 
			    )
			    VALUES (
			        #{assetId}, #{adminId}, #{partId}, #{type}, #{partName}, #{resolverName}, #{requestId}, #{owner}
			    )
			</insert>
						
		
		<update id="updateAssetStatus"  parameterType="int">
				UPDATE asset
				       SET status = 'MAINTAINING'
				 WHERE asset_id = #{assetId}
		</update>
		
  </mapper>