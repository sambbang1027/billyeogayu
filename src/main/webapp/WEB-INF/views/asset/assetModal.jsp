<!-- 공통 자산 모달 -->
<div
  class="asset-modal hidden"
  id="assetModal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="assetModalTitle"
  aria-describedby="assetModalDesc"
>
  <div class="asset-modal-panel" role="document">
    <h3 class="asset-modal-title" id="assetModalTitle">제목</h3>

    <p class="asset-modal-desc" id="assetModalDesc">내용</p>

    <div class="asset-modal-actions">
      <button type="button" class="asset-btn asset-btn-primary" id="assetModalOkBtn">확인</button>
      <button type="button" class="asset-btn asset-btn-ghost"   id="assetModalCancelBtn">취소</button>
    </div>
  </div>
</div>
